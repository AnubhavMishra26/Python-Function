    "15. Create a simple calculator:\n",
    "\n",
    ". Take two numbers and an operator (+, -, *, /)\n",
    ". Perform operation based on user input."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 37,
   "id": "2048e180-739b-4f07-ab2a-cccba7baa825",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter first number:  25\n",
      "Enter second number:  25\n",
      "Enter operator (+, -, *, /):  *\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Result = 625.0\n"
     ]
    }
   ],
   "source": [
    "def calculator(a, b, op):\n",
    "    if op == '+':\n",
    "        print(\"Result =\", a + b)\n",
    "    elif op == '-':\n",
    "        print(\"Result =\", a - b)\n",
    "    elif op == '*':\n",
    "        print(\"Result =\", a * b)\n",
    "    elif op == '/':\n",
    "        if b != 0:\n",
    "            print(\"Result =\", a / b)\n",
    "        else:\n",
    "            print(\"Cannot divide by zero.\")\n",
    "    else:\n",
    "        print(\"Invalid operator.\")\n",
    "\n",
    "num1 = float(input(\"Enter first number: \"))\n",
    "num2 = float(input(\"Enter second number: \"))\n",
    "operator = input(\"Enter operator (+, -, *, /): \")\n",
    "\n",
    "calculator(num1, num2, operator)"
   ]
